<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>TeconMoonWiiVCInjector</AssemblyName>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../TeconMoon's WiiVC Injector/Resources/wiitdb.txt" LogicalName="wiitdb.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- Teconmoon Nintendont build (boot.dol, meta.xml, icon.png). See ../nintendont-teconmoon/README.md. -->
    <None Include="Assets/nintendont-teconmoon/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>
</Project>
