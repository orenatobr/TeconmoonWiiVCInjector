<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WiiVCInjector"
        x:Class="WiiVCInjector.MainWindow" Width="1020" Height="740" MinWidth="900" MinHeight="660"
        Title="WiiVC Injector" FontSize="13">
  <Grid RowDefinitions="Auto,*">

    <!-- header band: brand, mode tiles, tools -->
    <Border Grid.Row="0" Background="{DynamicResource BandBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,18,24,18">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="{DynamicResource LogoStart}" />
                <GradientStop Offset="1" Color="{DynamicResource LogoEnd}" />
              </LinearGradientBrush>
            </Border.Background>
            <Path Classes="icon" Stroke="White" Width="22" Height="22" Data="{StaticResource IconBox}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="h1" Text="WiiVC Injector" />
            <TextBlock Name="VersionText" Classes="sub" Text="TeconMoon's injector for macOS" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Name="SettingsButton" Classes="ghost" Click="SettingsButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon muted" Data="{StaticResource IconSliders}" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
            <Button Name="SDCardStuff" Classes="ghost" Click="SDCardStuff_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon muted" Data="{StaticResource IconSdCard}" />
                <TextBlock Text="Nintendont SD Card Menu" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <UniformGrid Columns="4">
          <RadioButton Name="WiiRetail" Classes="tile" GroupName="Mode" IsChecked="True" IsCheckedChanged="WiiRetail_CheckedChanged">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Wii Retail Injection" />
              <TextBlock Classes="sub" Text="Wii disc image (ISO, WBFS)" />
            </StackPanel>
          </RadioButton>
          <RadioButton Name="WiiHomebrew" Classes="tile" GroupName="Mode" IsCheckedChanged="WiiHomebrew_CheckedChanged">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Wii Homebrew Injection" />
              <TextBlock Classes="sub" Text="Homebrew program (DOL)" />
            </StackPanel>
          </RadioButton>
          <RadioButton Name="GCRetail" Classes="tile" GroupName="Mode" IsCheckedChanged="GCRetail_CheckedChanged">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="GC Retail Injection" />
              <TextBlock Classes="sub" Text="GameCube disc (via Nintendont)" />
            </StackPanel>
          </RadioButton>
          <RadioButton Name="WiiNAND" Classes="tile" Margin="0" GroupName="Mode" IsCheckedChanged="WiiNAND_CheckedChanged">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="vWii NAND Title Launcher" />
              <TextBlock Classes="sub" Text="Channel installed on the vWii" />
            </StackPanel>
          </RadioButton>
        </UniformGrid>
      </StackPanel>
    </Border>

    <TabControl Name="MainTabs" Grid.Row="1" Classes="steps" TabStripPlacement="Left" Margin="16,12,0,0" SelectionChanged="MainTabs_SelectedIndexChanged">

      <!-- 1. required source files -->
      <TabItem Name="SourceFilesTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*" Width="190">
            <Border Classes="stepnum" VerticalAlignment="Center"><TextBlock Text="1" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Source files" />
              <TextBlock Classes="sub" Text="Game, icon and banner" />
            </StackPanel>
          </Grid>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="8,4,24,24" Spacing="14">
            <TextBlock Classes="h2" Text="Required source files" />

            <Border Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="iconbox" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconDisc}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Game" />
                    <local:WfLabel Name="GameSourceDirectory" ShowDot="True" Status="False" TextTrimming="CharacterEllipsis" Text="Game file has not been specified" />
                  </StackPanel>
                  <Button Name="GameSourceButton" Grid.Column="2" Classes="browse" VerticalAlignment="Center" Click="GameSourceButton_Click" Content="Browse..." />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <StackPanel Spacing="4">
                    <TextBlock Name="IGNText" Classes="sub" Text="Internal game name" />
                    <Border Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                      <local:WfLabel Name="GameNameLabel" TextTrimming="CharacterEllipsis" Text="" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Name="ITIDText" Classes="sub" Text="Internal game title ID" />
                    <Border Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                      <local:WfLabel Name="TitleIDLabel" TextTrimming="CharacterEllipsis" Text="" />
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="iconbox" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconStar}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Icon" />
                    <local:WfLabel Name="IconSourceDirectory" ShowDot="True" Status="False" TextTrimming="CharacterEllipsis" Text="Icon has not been specified" />
                  </StackPanel>
                  <Button Name="IconSourceButton" Grid.Column="2" Classes="browse" VerticalAlignment="Center" Click="IconSourceButton_Click" Content="Icon..." />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="iconbox" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconTv}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Banner" />
                    <local:WfLabel Name="BannerSourceDirectory" ShowDot="True" Status="False" TextTrimming="CharacterEllipsis" Text="Banner has not been specified" />
                  </StackPanel>
                  <Button Name="BannerSourceButton" Grid.Column="2" Classes="browse" VerticalAlignment="Center" Click="BannerSourceButton_Click" Content="Banner..." />
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="20" Margin="0,4,0,0">
                  <StackPanel Spacing="6">
                    <local:WfLabel Name="IconPreviewText" Classes="sub" Text="Icon preview (128x128)" />
                    <Border Name="IconPreviewBox" Classes="preview" Width="144" Height="144">
                      <Grid>
                        <Path Classes="icon muted" Width="28" Height="28" Data="{StaticResource IconImage}" />
                        <Image Name="IconPreviewBoxImg" Stretch="Uniform" />
                      </Grid>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <local:WfLabel Name="BannerPreviewText" Classes="sub" Text="Banner preview (1280x720)" />
                    <Border Name="BannerPreviewBox" Classes="preview" Width="256" Height="144">
                      <Grid>
                        <Path Classes="icon muted" Width="28" Height="28" Data="{StaticResource IconTv}" />
                        <Image Name="BannerPreviewBoxImg" Stretch="Uniform" />
                      </Grid>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Classes="sub" TextAlignment="Right" MaxWidth="190" Text="No artwork of your own? Fetch it from the community repository." />
                    <Button Name="RepoDownload" HorizontalAlignment="Right" Click="RepoDownload_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon muted" Data="{StaticResource IconDownload}" />
                        <TextBlock Text="Download from cucholix's repo" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 2. optional source files -->
      <TabItem Name="SourceFilesTab2">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*" Width="190">
            <Border Classes="stepnum" VerticalAlignment="Center"><TextBlock Text="2" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Extras" />
              <TextBlock Classes="sub" Text="Optional files" />
            </StackPanel>
          </Grid>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="8,4,24,24" Spacing="14">
            <TextBlock Classes="h2" Text="Optional source files" />

            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="iconbox" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconDisc}" /></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="2nd GameCube disc" />
                  <local:WfLabel Name="GC2SourceDirectory" ShowDot="True" Status="False" TextTrimming="CharacterEllipsis" Text="2nd GameCube Disc Image has not been specified" />
                </StackPanel>
                <Button Name="GC2SourceButton" Grid.Column="2" Classes="browse" VerticalAlignment="Center" IsEnabled="False" Click="GC2SourceButton_Click" Content="2nd GC Disc" />
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="iconbox" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconStar}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Boot logo" />
                    <local:WfLabel Name="LogoSourceDirectory" ShowDot="True" Status="False" TextTrimming="CharacterEllipsis" Text="Boot Logo has not been specified" />
                  </StackPanel>
                  <Button Name="LogoSourceButton" Grid.Column="2" Classes="browse" VerticalAlignment="Center" Click="LogoSourceButton_Click" Content="Boot Logo..." />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="iconbox" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconGamepad}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="GamePad banner" />
                    <local:WfLabel Name="DrcSourceDirectory" ShowDot="True" Status="False" TextTrimming="CharacterEllipsis" Text="GamePad Banner has not been specified" />
                  </StackPanel>
                  <Button Name="DrcSourceButton" Grid.Column="2" Classes="browse" VerticalAlignment="Center" Click="DrcSourceButton_Click" Content="GamePad Banner..." />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="20" Margin="0,4,0,0">
                  <StackPanel Spacing="6">
                    <local:WfLabel Name="LogoPreviewText" Classes="sub" Text="Logo preview (170x42)" />
                    <Border Name="LogoPreviewBox" Classes="preview" Width="170" Height="42">
                      <Grid>
                        <Path Classes="icon muted" Width="20" Height="20" Data="{StaticResource IconStar}" />
                        <Image Name="LogoPreviewBoxImg" Stretch="Uniform" />
                      </Grid>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <local:WfLabel Name="DrcPreviewText" Classes="sub" Text="GamePad banner preview (854x480)" />
                    <Border Name="DrcPreviewBox" Classes="preview" Width="256" Height="144">
                      <Grid>
                        <Path Classes="icon muted" Width="28" Height="28" Data="{StaticResource IconGamepad}" />
                        <Image Name="DrcPreviewBoxImg" Stretch="Uniform" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="iconbox" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconSound}" /></Border>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="Boot sound" />
                  <local:WfLabel Name="BootSoundDirectory" ShowDot="True" Status="False" TextTrimming="CharacterEllipsis" Text="Boot Sound has not been specified" />
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <Button Name="BootSoundPreviewButton" IsEnabled="False" Click="BootSoundPreviewButton_Click" Content="Play Sound" />
                    <CheckBox Name="ToggleBootSoundLoop" VerticalAlignment="Center" IsCheckedChanged="ToggleBootSoundLoop_CheckedChanged" Content="Loop boot sound" />
                    <local:WfLabel Name="BootSoundPreviewText" Classes="sub" VerticalAlignment="Center" Text="WAV, cut off after 6 seconds" />
                  </StackPanel>
                </StackPanel>
                <Button Name="BootSoundButton" Grid.Column="2" Classes="browse" VerticalAlignment="Top" Click="BootSoundButton_Click" Content="Boot Sound..." />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 3. title and gamepad -->
      <TabItem Name="MetaTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*" Width="190">
            <Border Classes="stepnum" VerticalAlignment="Center"><TextBlock Text="3" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Title and GamePad" />
              <TextBlock Classes="sub" Text="Name, ID and controls" />
            </StackPanel>
          </Grid>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="8,4,24,24" Spacing="14">
            <TextBlock Classes="h2" Text="GamePad and meta options" />

            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <local:WfLabel Name="PackedTitleText" FontWeight="SemiBold" Text="Name to use for Packaged Title (ACCENT CHARACTERS NOT SUPPORTED)" />
                  <TextBox Name="PackedTitleLine1" MaxLength="32" Text="" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Name="PackedTitleLine2" Classes="locked" IsReadOnly="True" MaxLength="32" Text="(Optional) Line 2" />
                    <CheckBox Name="EnablePackedLine2" Grid.Column="1" IsCheckedChanged="EnablePackedLine2_CheckedChanged" Content="Use Line 2" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <local:WfLabel Name="PackedTitleIDText" FontWeight="SemiBold" Text="Pre-generated Title ID (Changing this is not recommended)" />
                  <TextBox Name="PackedTitleIDLine" MaxLength="16" FontFamily="Menlo,Monaco,monospace" Text="" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <local:WfLabel Name="GamePadModeText" FontWeight="SemiBold" Text="GamePad Emulation Mode" />
                  <TextBlock Classes="sub" Text="Only applicable for Wii Retail Injections and the vWii NAND Title Launcher." />
                </StackPanel>
                <UniformGrid Name="GamePadEmuLayout" Columns="2" Margin="0,0,-10,0">
                  <RadioButton Name="NoGamePadEmu" Classes="choice" GroupName="GamePadEmuLayout" IsChecked="True" IsCheckedChanged="NoGamePadEmu_CheckedChanged" Content="No GamePad emulation, Wii Remotes only" />
                  <RadioButton Name="CCEmu" Classes="choice" GroupName="GamePadEmuLayout" IsCheckedChanged="CCEmu_CheckedChanged" Content="Classic Controller Emulation" />
                  <RadioButton Name="VerWiiMote" Classes="choice" GroupName="GamePadEmuLayout" IsCheckedChanged="VerWiiMote_CheckedChanged" Content="*Vertical Wii Remote Emulation" />
                  <RadioButton Name="HorWiiMote" Classes="choice" GroupName="GamePadEmuLayout" IsCheckedChanged="HorWiiMote_CheckedChanged" Content="*Horizontal Wii Remote emulation" />
                  <RadioButton Name="ForceCC" Classes="choice" GroupName="GamePadEmuLayout" IsCheckedChanged="ForceCC_CheckedChanged" Content="**Force Classic Controller Connected" />
                  <RadioButton Name="ForceNoCC" Classes="choice" GroupName="GamePadEmuLayout" IsCheckedChanged="ForceWiiMote_CheckedChanged" Content="**Force No Classic Controller" />
                </UniformGrid>
                <CheckBox Name="LRPatch" IsEnabled="False" Content="Swap L &amp; R with ZL &amp; ZR" />
                <local:WfLabel Name="AdvancedLabel5" Classes="sub" Text="*Wii Remote Emulation modes don't support infrared pointing or motion detection.&#10;**The force options should only be used if your game doesn't detect your controller mode properly. (For example, Resident Evil 4 Wii Edition supports the Classic Controller, but it won't work without being patched)&#10;**When using the force options, Wii Retail Injections will be patched automatically. For vWii NAND Titles, you may also need to patch your WAD before installing it to NAND:" />
                <local:WfLink Name="TutorialLink" Click="TutorialLink_LinkClicked" Text="Instructions" Foreground="{DynamicResource AccentStroke}" Cursor="Hand" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 4. advanced -->
      <TabItem Name="AdvancedTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*" Width="190">
            <Border Classes="stepnum" VerticalAlignment="Center"><TextBlock Text="4" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Advanced" />
              <TextBlock Classes="sub" Text="Patches and options" />
            </StackPanel>
          </Grid>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="8,4,24,24" Spacing="14">
            <TextBlock Classes="h2" Text="Advanced options" />

            <Border Classes="card">
              <StackPanel Spacing="6">
                <local:WfLabel Name="label1" FontWeight="SemiBold" FontSize="14" Text="Nintendont Options" />
                <UniformGrid Columns="2">
                  <CheckBox Name="Force43NINTENDONT" ToolTip.Tip="Disables &quot;Force Widescreen&quot; and &quot;WiiU Widescreen&quot; Flags" IsCheckedChanged="Force43NINTENDONT_CheckedChanged" Content="Force 4:3 for Nintendont" />
                  <CheckBox Name="ForceInterlacedNINTENDONT" ToolTip.Tip="Disables &quot;Force Progressive&quot; Flag" IsCheckedChanged="ForceInterlacedNINTENDONT_CheckedChanged" Content="Force interlaced for Nintendont" />
                </UniformGrid>
                <CheckBox Name="DisableNintendontAutoboot" IsCheckedChanged="NintendontAutoboot_CheckedChanged" Content="Disable Autoboot" />
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                  <CheckBox Name="CustomMainDol" IsCheckedChanged="CustomMainDol_CheckedChanged" Content="Specify custom Nintendont Forwarder" />
                  <Button Name="MainDolSourceButton" Grid.Column="1" MinWidth="40" IsEnabled="False" Click="MainDolSourceButton_Click" Content="..." />
                  <Border Grid.Column="2" Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <local:WfLabel Name="MainDolLabel" TextTrimming="CharacterEllipsis" Text="&lt;- Specify custom main.dol file" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="6">
                <local:WfLabel Name="AdvancedLabel1" FontWeight="SemiBold" FontSize="14" Text="Wii Homebrew Patches" />
                <CheckBox Name="DisablePassthrough" IsCheckedChanged="DisablePassthrough_CheckedChanged" Content="Disable Wii Remote passthrough in GamePad mode" />
                <CheckBox Name="DisableGamePad" IsCheckedChanged="DisableGamePad_CheckedChanged" Content="Don't use GamePad as controller (Won't prompt for usage)" />
                <CheckBox Name="C2WPatchFlag" IsCheckedChanged="C2WPatchFlag_CheckedChanged" Content="Enable cafe2wii patching (NOT RECOMMENDED)" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Name="AncastKey" Classes="locked" IsReadOnly="True" MaxLength="32" FontFamily="Menlo,Monaco,monospace" Text="Wii U Starbuck Ancast Key Required" />
                  <Button Name="SaveAncastKeyButton" Grid.Column="1" IsEnabled="False" Click="SaveAncastKeyButton_Click" Content="Save Key" />
                </Grid>
                <local:WfLabel Name="AdvancedLabel2" Classes="sub" Text="cafe2wii patching unlocks the vWii clock speed for supported homebrew like WiiSXR or Nintendont. cafe2wii patched titles MUST be launched using:" />
                <local:WfLink Name="sign_c2w_patcher_link" Click="sign_c2w_patcher_link_LinkClicked" Text="sign_c2w_patcher" Foreground="{DynamicResource AccentStroke}" Cursor="Hand" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="6">
                <local:WfLabel Name="label2" FontWeight="SemiBold" FontSize="14" Text="Wii Retail Injection / vWii NAND Title Launcher Patches" />
                <UniformGrid Columns="2">
                  <CheckBox Name="DisableTrimming" IsCheckedChanged="DisableTrimming_CheckedChanged" Content="Don't trim game output (Wii Retail only)" />
                  <CheckBox Name="Force43NAND" Content="Force 4:3 (vWii NAND Titles only)" />
                </UniformGrid>
                <CheckBox Name="WiiVMC" Content="Patch video mode (Wii Retail only, picks the mode when ticked, experimental)" />
                <CheckBox Name="Wiimmfi" Content="Patch game to use the Wiimmfi server for online play (Wii Retail only)" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 5. build -->
      <TabItem Name="BuildTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*" Width="190">
            <Border Classes="stepnum" VerticalAlignment="Center"><TextBlock Text="5" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Build" />
              <TextBlock Classes="sub" Text="Keys, checks, package" />
            </StackPanel>
          </Grid>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="8,4,24,24" Spacing="14">
            <TextBlock Classes="h2" Text="Build title" />

            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <local:WfLabel Name="CommonLabel" FontWeight="SemiBold" Text="Wii U Common Key - (Google it)" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Name="WiiUCommonKey" MaxLength="32" FontFamily="Menlo,Monaco,monospace" Text="" />
                    <Button Name="SaveCommonKeyButton" Grid.Column="1" Click="SaveCommonKeyButton_Click" Content="Save Key" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <local:WfLabel Name="RHFKeyLabel" FontWeight="SemiBold" Text="Rhythm Heaven Fever [USA] Title Key - (Find it on &quot;that one title key site&quot;)" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Name="TitleKey" MaxLength="32" FontFamily="Menlo,Monaco,monospace" Text="" />
                    <Button Name="SaveTitleKeyButton" Grid.Column="1" Click="SaveTitleKeyButton_Click" Content="Save Key" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <local:WfLabel Name="RequirementsLabel" FontWeight="SemiBold" FontSize="14" Text="Requirements" />
                <local:WfLabel Name="SourceCheck" Classes="tint" ShowDot="True" Text="Source Files are properly specified" />
                <local:WfLabel Name="MetaCheck" Classes="tint" ShowDot="True" Text="Meta options are valid" />
                <local:WfLabel Name="AdvanceCheck" Classes="tint" ShowDot="True" Text="No advanced options conflicting" />
                <local:WfLabel Name="KeysCheck" Classes="tint" ShowDot="True" Text="Required keys are properly specified" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <local:WfLabel Name="BuildStatus" Classes="sub" Text="" />
                <ProgressBar Name="BuildProgress" Minimum="0" Maximum="100" Value="0" />
                <Button Name="TheBigOneTM" Classes="accent" HorizontalAlignment="Stretch" MinHeight="52" FontSize="17" FontWeight="SemiBold" IsEnabled="False" Click="TheBigOneTM_Click">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Stroke="White" Data="{StaticResource IconBox}" />
                    <TextBlock Text="BUILD" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
