diff --git a/kernel/main.c b/kernel/main.c
index fac0829..5af14d5 100644
--- a/kernel/main.c
+++ b/kernel/main.c
@@ -331,6 +331,11 @@ int _main( int argc, char *argv[] )
 			write32(0xd8006a0, 0x30000002), mask32(0xd8006a8, 0, 2);
 	}
 
+	// Wii U aspect currently on screen (the widescreen option sets the start value), and the last
+	// L+R+A press count seen from the PPC side (last word of the RESET_STATUS cache line).
+	bool wiiuWide = ConfigGetConfig(NIN_CFG_WIIU_WIDE);
+	u32 wideTogglesSeen = 0;
+
 	while (1)
 	{
 		_ahbMemFlush(0);
@@ -459,6 +464,18 @@ int _main( int argc, char *argv[] )
 		}
 		sync_before_read((void*)RESET_STATUS, 0x20);
 		vu32 reset_status = read32(RESET_STATUS);
+		u32 wideToggles = read32(RESET_STATUS + 0x1C);
+		if (wideToggles != wideTogglesSeen)
+		{
+			wideTogglesSeen = wideToggles;
+			if (IsWiiU())
+			{
+				wiiuWide = !wiiuWide;
+				write32(0xd8006a0, wiiuWide ? 0x30000004 : 0x30000002);
+				mask32(0xd8006a8, 0, 2);
+				dbgprintf("L+R+A: Wii U output %s\r\n", wiiuWide ? "16:9" : "4:3");
+			}
+		}
 		if (reset_status == 0x1DEA)
 		{
 			dbgprintf("Game Exit\r\n");
diff --git a/loader/source/main.c b/loader/source/main.c
index aef1e55..ebd6340 100644
--- a/loader/source/main.c
+++ b/loader/source/main.c
@@ -1233,6 +1233,26 @@ int main(int argc, char **argv)
 		ncfg->Config &= ~NIN_CFG_FORCE_PROG;
 	}
 
+	if(BI2region == BI2_REGION_PAL)
+	{	//A PAL game forced to 60 Hz plays its sound late against the picture (Force Progressive was
+		//confirmed on Skies of Arcadia). Keep PAL discs at their own 50 Hz whatever the config says.
+		if(ncfg->Config & NIN_CFG_FORCE_PROG)
+		{
+			gprintf("PAL disc: Force Progressive ignored, it delays the audio\r\n");
+			ncfg->Config &= ~NIN_CFG_FORCE_PROG;
+		}
+		if(ncfg->VideoMode & NIN_VID_PATCH_PAL50)
+		{
+			gprintf("PAL disc: Patch PAL50 ignored, it delays the audio\r\n");
+			ncfg->VideoMode &= ~NIN_VID_PATCH_PAL50;
+		}
+		if((ncfg->VideoMode & NIN_VID_FORCE) && (ncfg->VideoMode & NIN_VID_FORCE_MASK) != NIN_VID_FORCE_PAL50)
+		{
+			gprintf("PAL disc: forced 60 Hz video mode ignored, it delays the audio\r\n");
+			ncfg->VideoMode &= ~NIN_VID_FORCE;
+		}
+	}
+
 	//make sure the cfg gets to the kernel
 	DCStoreRange((void*)ncfg, sizeof(NIN_CFG));
 
