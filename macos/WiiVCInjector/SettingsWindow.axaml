<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WiiVCInjector"
        x:Class="WiiVCInjector.SettingsWindow" Width="560" Height="340" CanResize="False"
        Title="Application Settings" FontSize="13">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Spacing="14">
      <TextBlock Classes="h2" Text="Application settings" />
      <Border Classes="card">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <local:WfLabel Name="BannersRepositoryLabel" FontWeight="SemiBold" Text="Banners Repository" />
            <TextBox Name="BannersRepository" Text="" />
          </StackPanel>
          <StackPanel Spacing="6">
            <local:WfLabel Name="OutputDirLabel" FontWeight="SemiBold" Text="Output Directory (leave empty to always ask)" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Name="OutputDir" Text="" />
              <Button Name="OutputDirButton" Grid.Column="1" Classes="browse" Click="OutputDirButton_Click" Content="Browse..." />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Name="Cancel" MinWidth="96" Content="Cancel" />
      <Button Name="OkButton" Classes="accent" MinWidth="96" Click="OkButton_Click" Content="OK" />
    </StackPanel>
  </Grid>
</Window>
