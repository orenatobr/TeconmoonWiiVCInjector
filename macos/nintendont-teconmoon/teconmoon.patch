diff --git a/loader/source/GameSettings.c b/loader/source/GameSettings.c
new file mode 100644
index 0000000..ab2da4e
--- /dev/null
+++ b/loader/source/GameSettings.c
@@ -0,0 +1,75 @@
+#include <string.h>
+#include <strings.h>
+#include <stdlib.h>
+#include "GameSettings.h"
+
+static char *Trim(char *s)
+{
+	while (*s == ' ' || *s == '\t')
+		s++;
+	char *e = s + strlen(s);
+	while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r'))
+		*--e = 0;
+	return s;
+}
+
+/* 1 for True, 1 and Yes; 0 for False, 0 and No; -1 for anything else */
+static int Bool(const char *v)
+{
+	if (!strcasecmp(v, "true") || !strcmp(v, "1") || !strcasecmp(v, "yes"))
+		return 1;
+	if (!strcasecmp(v, "false") || !strcmp(v, "0") || !strcasecmp(v, "no"))
+		return 0;
+	return -1;
+}
+
+int GameSettingsParse(char *text, signed char out[GS_COUNT])
+{
+	int i, n = 0;
+	for (i = 0; i < GS_COUNT; i++)
+		out[i] = -1;
+	while (text && *text)
+	{
+		char *next = strchr(text, '\n');
+		if (next)
+			*next++ = 0;
+		char *line = Trim(text);
+		text = next;
+		char *eq = strchr(line, '=');
+		if (line[0] == '#' || line[0] == ';' || line[0] == '[' || !eq)
+			continue;
+		*eq = 0;
+		char *key = Trim(line);
+		char *val = Trim(eq + 1);
+		int which = -1, v = -1;
+		if (!strcasecmp(key, "AspectRatio"))
+		{
+			which = GS_WIIU_WIDE;
+			int a = atoi(val);
+			v = a == 1 ? 1 : a == 2 ? 0 : -1;
+		}
+		else if (!strcasecmp(key, "wideScreenHack"))
+			which = GS_FORCE_WIDE, v = Bool(val);
+		else if (!strcasecmp(key, "ProgressiveScan"))
+			which = GS_FORCE_PROG, v = Bool(val);
+		else if (!strcasecmp(key, "SkipIPL"))
+			which = GS_SKIP_IPL, v = Bool(val);
+		else if (!strcasecmp(key, "PatchPAL50"))
+			which = GS_PATCH_PAL50, v = Bool(val);
+		else if (!strcasecmp(key, "Deflicker"))
+			which = GS_DEFLICKER, v = Bool(val);
+		else if (!strcasecmp(key, "VideoMode"))
+		{
+			which = GS_VIDEO_MODE;
+			v = !strcasecmp(val, "auto") ? 0 : !strcasecmp(val, "pal50") ? 1 : !strcasecmp(val, "pal60") ? 2 :
+			    !strcasecmp(val, "ntsc") ? 3 : !strcasecmp(val, "mpal") ? 4 : -1;
+		}
+		if (which >= 0 && v >= 0)
+		{
+			if (out[which] < 0)
+				n++;
+			out[which] = (signed char)v;
+		}
+	}
+	return n;
+}
diff --git a/loader/source/GameSettings.h b/loader/source/GameSettings.h
new file mode 100644
index 0000000..5fa6822
--- /dev/null
+++ b/loader/source/GameSettings.h
@@ -0,0 +1,34 @@
+#ifndef GAMESETTINGS_H
+#define GAMESETTINGS_H
+
+/*
+ * Teconmoon: per game settings. /teconmoon/<game id>.ini holds a few keys of Dolphin's GameINI format.
+ * Section names are ignored and every other line is skipped, so a Dolphin GameSettings file can be used as it is.
+ *
+ *   AspectRatio     = 1 (16:9) or 2 (4:3)   Wii U Widescreen on or off (0 or anything else: leave it)
+ *   wideScreenHack  = True or False         Force Widescreen
+ *   ProgressiveScan = True or False         Force Progressive
+ *   SkipIPL         = True or False         Skip IPL
+ *   PatchPAL50      = True or False         Patch PAL50 (Teconmoon key, Dolphin has none)
+ *   VideoMode       = Auto, PAL50, PAL60, NTSC or MPAL   force that video mode, or leave it to the game (Teconmoon key)
+ *   Deflicker       = True or False         with a forced VideoMode: the GX deflicker filter on or off (Teconmoon key)
+ *
+ * ProgressiveScan = True, PatchPAL50 = True and a forced VideoMode other than Auto also switch off the PAL guard of this loader for that
+ * game: it is the user's choice. VideoMode = PAL50 keeps a PAL game at 50 Hz, so with Deflicker = False it only turns the filter off.
+ */
+enum GameSetting
+{
+	GS_WIIU_WIDE,
+	GS_FORCE_WIDE,
+	GS_FORCE_PROG,
+	GS_SKIP_IPL,
+	GS_PATCH_PAL50,
+	GS_VIDEO_MODE,		/* 0 Auto, 1 PAL50, 2 PAL60, 3 NTSC, 4 MPAL */
+	GS_DEFLICKER,
+	GS_COUNT
+};
+
+/* Reads the text (modified in place) and sets out[i] to 1 (on), 0 (off) or -1 (not mentioned). Returns how many are set. */
+int GameSettingsParse(char *text, signed char out[GS_COUNT]);
+
+#endif
