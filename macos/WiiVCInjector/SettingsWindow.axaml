<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WiiVCInjector"
        x:Class="WiiVCInjector.SettingsWindow" Width="369" Height="295" CanResize="False"
        Title="Application Settings" Background="#F0F0F0" FontSize="11">
    <Canvas>
      <local:WfLabel Name="OutputDirLabel" Canvas.Left="12" Canvas.Top="60" Width="262" Height="15" Text="Output Directory (leave empty to always ask)"/>
      <TextBox Name="OutputDir" Canvas.Left="12" Canvas.Top="78" Width="255" Height="20" Text="" Classes="wf"/>
      <local:WfLabel Name="BannersRepositoryLabel" Canvas.Left="12" Canvas.Top="9" Width="118" Height="16" Text="Banners Repository"/>
      <TextBox Name="BannersRepository" Canvas.Left="12" Canvas.Top="28" Width="345" Height="20" Text="" Classes="wf"/>
      <Button Name="OutputDirButton" Canvas.Left="273" Canvas.Top="74" Width="84" Height="26" Click="OutputDirButton_Click" Classes="wf"><TextBlock Text="Browse..." TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/></Button>
      <Button Name="OkButton" Canvas.Left="183" Canvas.Top="257" Width="84" Height="26" Click="OkButton_Click" Classes="wf"><TextBlock Text="OK" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/></Button>
      <Button Name="Cancel" Canvas.Left="273" Canvas.Top="257" Width="84" Height="26" Classes="wf"><TextBlock Text="Cancel" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/></Button>
    </Canvas>
</Window>
